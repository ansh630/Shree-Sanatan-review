<script>
  const GOOGLE_REVIEW_URL = "https://g.page/r/CfSyRDG_4IHcEBM/review";
  const GEMINI_API_KEY = "AQ.Ab8RN6JVwpvU9dJJNvCX6JJIkQJ4TiIZEcAe_gqy1jfiFYuV7Q";

  let selectedRating = 0;
  let selectedTags = [];

  function selectRating(rating) {
    selectedRating = rating;
    const stars = document.querySelectorAll('.star-btn');
    stars.forEach((star, index) => {
      if (index < rating) {
        star.classList.remove('text-gray-300');
        star.classList.add('text-yellow-400');
      } else {
        star.classList.remove('text-yellow-400');
        star.classList.add('text-gray-300');
      }
    });

    document.getElementById('tags-section').classList.remove('hidden');
    generateAIReview();
  }

  function toggleTag(btn) {
    const tag = btn.innerText;
    if (selectedTags.includes(tag)) {
      selectedTags = selectedTags.filter(t => t !== tag);
      btn.classList.remove('bg-indigo-600', 'text-white');
      btn.classList.add('bg-gray-100', 'text-gray-700');
    } else {
      selectedTags.push(tag);
      btn.classList.add('bg-indigo-600', 'text-white');
      btn.classList.remove('bg-gray-100', 'text-gray-700');
    }
    generateAIReview();
  }

  async function generateAIReview() {
    if (selectedRating === 0) return;

    document.getElementById('loading').classList.remove('hidden');
    document.getElementById('review-box').classList.add('hidden');

    const prompt = `Write a natural, authentic, human-sounding 1-3 sentence customer review for a business based on a ${selectedRating}-star rating. Highlight features: ${selectedTags.join(', ') || 'overall good experience'}. Do not use overly formal or robotic language. Output only the review text.`;

    try {
      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${GEMINI_API_KEY}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: prompt }] }]
        })
      });

      const data = await response.json();
      const reviewText = data.candidates?.[0]?.content?.parts?.[0]?.text?.trim() || "Great service and excellent experience!";

      document.getElementById('ai-review-text').value = reviewText;
      document.getElementById('loading').classList.add('hidden');
      document.getElementById('review-box').classList.remove('hidden');
    } catch (error) {
      console.error("AI Generation Error:", error);
      document.getElementById('loading').classList.add('hidden');
      document.getElementById('ai-review-text').value = "Highly recommended! Excellent service and helpful team.";
      document.getElementById('review-box').classList.remove('hidden');
    }
  }

  function copyAndRedirect() {
    const reviewText = document.getElementById('ai-review-text').value;

    navigator.clipboard.writeText(reviewText).then(() => {
      window.location.href = GOOGLE_REVIEW_URL;
    }).catch(err => {
      window.location.href = GOOGLE_REVIEW_URL;
    });
  }
</script>
